{
  "name": "hato-tms",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "prisma generate --schema packages/db/prisma/schema.prisma && yarn workspace @hato-tms/shared run build && yarn workspace @hato-tms/db run build",
    "dev": "turbo dev --filter=@hato-tms/api --filter=@hato-tms/web --filter=@hato-tms/web-v2",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:api": "yarn workspace @hato-tms/api run dev",
    "dev:web": "yarn workspace @hato-tms/web run dev",
    "db:generate": "yarn workspace @hato-tms/db run generate",
    "db:migrate": "yarn workspace @hato-tms/db run migrate",
    "db:seed": "yarn workspace @hato-tms/db run seed",
    "db:studio": "yarn workspace @hato-tms/db run studio"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.24.0",
    "prisma": "^6.3.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "yarn@4.14.1",
  "resolutions": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
